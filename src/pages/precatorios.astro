---
/**
 * Página de anúncio sobre precatórios.
 *
 * Ela não pertence ao site: não entra no menu, não entra no sitemap e sai com
 * noindex. Existe só para receber o clique do anúncio, qualificar e mandar a
 * pessoa para o WhatsApp com o caso já escrito.
 *
 * Por isso não tem navbar nem rodapé do site: página de anúncio que oferece
 * saída perde a visita que custou dinheiro para chegar.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site, avaliacoes } from '@/content/data';

/* Oito avaliações reais do Google Negócios dela, as mais recentes da lista
   que já alimenta o site. Prova social num anúncio vale mais que explicação:
   por isso ficam logo abaixo do funil, e não uma seção institucional. */
const oitoAvaliacoes = avaliacoes.itens.slice(0, 8);
import { precatorios } from '@/content/precatorios';
import { withBase } from '@/lib/paths';
import Funil from '@/components/precatorios/Funil';

const zapDireto = `https://wa.me/${site.whatsapp.numero}?text=${encodeURIComponent(
  'Olá, Dra. Quesia! Vim pela página de precatórios e gostaria de tirar uma dúvida.'
)}`;
---

<BaseLayout
  titulo={`Precatórios · ${site.nome} ${site.sufixo}`}
  descricao="Tem precatório a receber e não sabe em que fase está? Responda seis perguntas e fale com a advogada Quesia Constâncio com o seu caso já organizado."
  caminho="/precatorios"
  noindex
>
  <div class="pagina-pre">
    <!-- Cabeçalho só com a marca: nada de menu, para não vazar a visita -->
    <header class="pre-topo">
      <img
        src={withBase('/logos/qc-mark-bone.png')}
        alt={`${site.nome} ${site.sufixo}`}
        width="30"
        height="34"
      />
      <span class="rotulo-caps">{site.nome} <em>{site.sufixo}</em></span>
    </header>

    <main>
      <!-- DOBRA: o funil sobe junto com o título, porque quem vem de anúncio
           decide nos primeiros segundos -->
      <!-- DOBRA: coluna única centrada. Página de anúncio precisa ser curta e
           objetiva, então aqui ficam só título, uma linha e o funil; tudo que
           é explicação desce para as faixas de baixo. -->
      <section class="pre-dobra" id="topo">
        <p class="rotulo-caps texto-ouro-claro">{precatorios.eyebrow}</p>
        <h1>{precatorios.titulo}</h1>
        <p class="pre-sub">{precatorios.subtitulo}</p>

        <ul class="pre-selos" role="list">
          <li>
            <span class="pre-estrela" aria-hidden="true">★</span>
            {avaliacoes.nota} no Google
          </li>
          {precatorios.selos.map((s) => <li>{s}</li>)}
        </ul>

        <div class="pre-cartao-area">
          <div class="pre-cartao">
            <Funil
              client:load
              passos={precatorios.passos}
              valores={precatorios.valores}
              whatsapp={site.whatsapp.numero}
              atalhoWhats="Prefiro ir direto ao WhatsApp"
            />
          </div>
        </div>

        <p class="pre-oab">Dra. {site.nome} · {site.oab}</p>
      </section>

      <!-- PROVA SOCIAL: oito avaliações reais do Google -->
      <section class="pre-provas-sociais" aria-labelledby="pre-avaliacoes-titulo">
        <div class="pre-provas-topo">
          <h2 id="pre-avaliacoes-titulo">O que dizem quem já foi atendido</h2>
          <a
            href={avaliacoes.url}
            target="_blank"
            rel="noopener noreferrer"
            class="pre-selo-google"
          >
            <span aria-hidden="true">★</span>
            {avaliacoes.nota} no Google · {avaliacoes.total} avaliações
          </a>
        </div>

        <ul class="pre-avaliacoes" role="list">
          {oitoAvaliacoes.map((a, i) => (
            <li class="pre-avaliacao" style={`--i: ${i}`}>
              <div class="pre-avaliacao-topo">
                <img
                  src={a.foto}
                  alt=""
                  width="40"
                  height="40"
                  loading="lazy"
                  decoding="async"
                  referrerpolicy="no-referrer"
                />
                <div>
                  <p class="pre-avaliacao-nome">{a.nome}</p>
                  <p class="pre-avaliacao-estrelas" aria-label={`${a.nota} de 5`}>
                    {'★'.repeat(a.nota)}
                  </p>
                </div>
              </div>
              <p class="pre-avaliacao-texto">{a.texto}</p>
            </li>
          ))}
        </ul>
      </section>

      <footer class="pre-rodape">
        <p>Dra. {site.nome} · {site.oab}</p>
        <p class="pre-aviso">{precatorios.aviso}</p>
      </footer>
    </main>

    <!-- Botão flutuante: fica pequeno, para não roubar o funil -->
    <a
      href={zapDireto}
      target="_blank"
      rel="noopener noreferrer"
      class="pre-fab"
      aria-label="Falar no WhatsApp"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413" />
      </svg>
    </a>
  </div>
</BaseLayout>
