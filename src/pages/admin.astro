---
import '@/styles/global.css';
import { site } from '@/content/data';
import { withBase } from '@/lib/paths';
import PainelLocal from '@/components/admin/PainelLocal.astro';

/* Um painel só. Ele mesmo detecta se há Supabase e troca o login, a origem
   da grade e a lista de pedidos. */
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Agenda · {site.nome} {site.sufixo}</title>
    <link rel="icon" type="image/png" href={withBase('/favicon.png')} />
  </head>
  <body class="min-h-dvh bg-bone-dim text-ink">
    <PainelLocal />
  </body>
</html>
