---
import '@/styles/global.css';
import { site } from '@/content/data';
import { withBase } from '@/lib/paths';
import { temSupabase } from '@/lib/supabase';
import Painel from '@/components/admin/Painel';
import PainelLocal from '@/components/admin/PainelLocal.astro';

/* Com as chaves do Supabase no .env, entra o painel que salva no banco e
   sincroniza sozinho. Sem elas, segue o painel que publica o grade.json. */
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Agenda · {site.nome} {site.sufixo}</title>
    <link rel="icon" type="image/png" href={withBase('/favicon.png')} />
  </head>
  <body class="min-h-dvh bg-bone-dim text-ink">
    {
      temSupabase ? (
        <Painel client:load urlGrade={withBase('/grade.json')} />
      ) : (
        <PainelLocal />
      )
    }
  </body>
</html>
