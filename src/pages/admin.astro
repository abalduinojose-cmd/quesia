---
import '@/styles/global.css';
import { site } from '@/content/data';
import { withBase } from '@/lib/paths';

const urlGrade = withBase('/grade.json');
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Agenda · {site.nome} {site.sufixo}</title>
    <link rel="icon" type="image/png" href={withBase('/favicon.png')} />
  </head>
  <body class="min-h-dvh bg-bone-dim text-ink">
    <!-- Entrada -->
    <div
      id="tela-login"
      class="fixed inset-0 z-50 flex items-center justify-center bg-ink px-5"
    >
      <div class="w-full max-w-sm">
        <img
          src={withBase('/logos/qc-mark-bone.png')}
          alt=""
          width="40"
          height="46"
          class="mx-auto h-11 w-auto"
        />
        <h1 class="mt-6 text-center font-display text-[1.9rem] leading-tight text-bone">
          Agenda da advogada
        </h1>
        <p class="mt-2 text-center text-sm text-bone-muted">
          Área restrita à equipe do escritório.
        </p>
        <form id="form-login" class="mt-8 flex flex-col gap-4">
          <label class="flex flex-col gap-2">
            <span class="rotulo-caps text-bone-muted">Usuário</span>
            <input
              id="usuario"
              type="text"
              autocomplete="username"
              class="rounded-xl border border-bone/15 bg-white/[0.04] px-4 py-3.5 text-bone outline-none transition-colors focus:border-gold"
            />
          </label>
          <label class="flex flex-col gap-2">
            <span class="rotulo-caps text-bone-muted">Senha</span>
            <input
              id="senha"
              type="password"
              autocomplete="current-password"
              class="rounded-xl border border-bone/15 bg-white/[0.04] px-4 py-3.5 text-bone outline-none transition-colors focus:border-gold"
            />
          </label>
          <p id="erro-login" class="hidden text-sm text-[#F2B8A2]">
            Usuário ou senha incorretos.
          </p>
          <button type="submit" class="btn-clean mt-1 w-full">Entrar</button>
        </form>
      </div>
    </div>

    <!-- Painel -->
    <div id="painel" class="hidden pb-28">
      <header class="sticky top-0 z-30 border-b border-gold-soft bg-bone/95 backdrop-blur">
        <div
          class="mx-auto flex w-full max-w-5xl items-center justify-between gap-4 px-5 py-3.5 sm:px-8"
        >
          <div class="flex items-center gap-3">
            <img
              src={withBase('/logos/qc-mark.png')}
              alt=""
              width="28"
              height="32"
              class="h-7 w-auto"
            />
            <div>
              <p class="font-display text-[1.1rem] leading-tight">Agenda</p>
              <p class="text-[0.72rem] text-ink-muted">
                No ar desde <span id="atualizado-em">-</span>
              </p>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <span
              id="selo-pendente"
              class="hidden rounded-full bg-[#B4462F]/12 px-3 py-1.5 text-[0.72rem] font-medium text-[#B4462F]"
            >
              não publicado
            </span>
            <a
              href={withBase('/')}
              class="rotulo-caps hidden rounded-full border border-ink/20 px-4 py-2 text-ink-muted transition-colors hover:border-ink hover:text-ink sm:inline-block"
            >
              Ver site
            </a>
            <button
              id="btn-sair"
              type="button"
              class="rotulo-caps rounded-full px-3 py-2 text-ink-muted transition-colors hover:text-ink"
            >
              Sair
            </button>
          </div>
        </div>

        <!-- Abas -->
        <div class="mx-auto w-full max-w-5xl px-5 sm:px-8">
          <div class="flex gap-1" role="tablist">
            <button
              type="button"
              data-aba="dias"
              class="aba rotulo-caps border-b-2 px-4 py-3 transition-colors"
              role="tab"
            >
              Próximos dias
            </button>
            <button
              type="button"
              data-aba="semana"
              class="aba rotulo-caps border-b-2 px-4 py-3 transition-colors"
              role="tab"
            >
              Grade fixa
            </button>
            <button
              type="button"
              data-aba="ajustes"
              class="aba rotulo-caps border-b-2 px-4 py-3 transition-colors"
              role="tab"
            >
              Ajustes
            </button>
          </div>
        </div>
      </header>

      <main class="mx-auto w-full max-w-5xl px-5 py-8 sm:px-8">
        <!-- Resumo -->
        <div class="grid grid-cols-3 gap-3">
          <div class="cartao rounded-2xl p-4 sm:p-5">
            <p id="kpi-livres" class="font-display text-[1.7rem] leading-none">0</p>
            <p class="mt-1.5 text-[0.72rem] leading-tight text-ink-muted">
              horários livres
            </p>
          </div>
          <div class="cartao rounded-2xl p-4 sm:p-5">
            <p id="kpi-ocupados" class="font-display text-[1.7rem] leading-none">0</p>
            <p class="mt-1.5 text-[0.72rem] leading-tight text-ink-muted">
              marcados como ocupados
            </p>
          </div>
          <div class="cartao rounded-2xl p-4 sm:p-5">
            <p id="kpi-bloqueios" class="font-display text-[1.7rem] leading-none">0</p>
            <p class="mt-1.5 text-[0.72rem] leading-tight text-ink-muted">
              dias bloqueados
            </p>
          </div>
        </div>

        <!-- Aba: próximos dias -->
        <section id="painel-dias" class="mt-8">
          <div class="flex flex-wrap items-end justify-between gap-3">
            <div>
              <h2 class="font-display text-[1.4rem]">Próximos dias</h2>
              <p class="mt-1 text-sm text-ink-muted">
                Toque num horário para marcar como ocupado. Toque de novo para liberar.
              </p>
            </div>
          </div>
          <div id="lista-dias" class="mt-5 flex flex-col gap-3"></div>
        </section>

        <!-- Aba: grade fixa -->
        <section id="painel-semana" class="mt-8 hidden">
          <h2 class="font-display text-[1.4rem]">Grade fixa da semana</h2>
          <p class="mt-1 text-sm text-ink-muted">
            Os horários marcados aqui valem para todas as semanas. É a base da agenda.
          </p>
          <div id="lista-semana" class="mt-5 flex flex-col gap-3"></div>
        </section>

        <!-- Aba: ajustes -->
        <section id="painel-ajustes" class="mt-8 hidden">
          <h2 class="font-display text-[1.4rem]">Ajustes</h2>
          <div class="cartao mt-5 flex flex-col gap-6 rounded-2xl p-6">
            <label class="flex flex-col gap-2">
              <span class="text-[0.95rem] font-medium">Antecedência mínima</span>
              <span class="text-sm text-ink-muted">
                Quanto tempo antes o cliente ainda pode escolher um horário.
              </span>
              <div class="mt-1 flex items-center gap-3">
                <input
                  id="in-antecedencia"
                  type="number"
                  min="0"
                  max="168"
                  class="w-28 rounded-xl border border-ink/15 bg-bone px-4 py-3 outline-none focus:border-gold-deep"
                />
                <span class="text-sm text-ink-muted">horas</span>
              </div>
            </label>
            <label class="flex flex-col gap-2">
              <span class="text-[0.95rem] font-medium">Janela de agendamento</span>
              <span class="text-sm text-ink-muted">
                Quantos dias à frente aparecem no site.
              </span>
              <div class="mt-1 flex items-center gap-3">
                <input
                  id="in-dias"
                  type="number"
                  min="7"
                  max="90"
                  class="w-28 rounded-xl border border-ink/15 bg-bone px-4 py-3 outline-none focus:border-gold-deep"
                />
                <span class="text-sm text-ink-muted">dias</span>
              </div>
            </label>
          </div>

          <div class="mt-6 rounded-2xl border border-gold/30 bg-gold/[0.06] p-6">
            <h3 class="font-display text-[1.2rem]">Como publicar</h3>
            <ol
              class="mt-3 flex list-decimal flex-col gap-1.5 pl-5 text-[0.92rem] text-ink-muted"
            >
              <li>Toque em <strong class="text-ink">Publicar</strong>, na barra de baixo.</li>
              <li>O arquivo <code class="rounded bg-ink/5 px-1.5 py-0.5">grade.json</code> é baixado.</li>
              <li>
                No GitHub, entre na pasta <code class="rounded bg-ink/5 px-1.5 py-0.5">docs</code>
                e envie o arquivo por cima do antigo.
              </li>
              <li>Em 2 a 3 minutos o site mostra os horários novos.</li>
            </ol>
          </div>

          <button
            id="btn-restaurar"
            type="button"
            class="rotulo-caps mt-6 rounded-full border border-ink/20 px-5 py-2.5 text-ink-muted transition-colors hover:border-[#B4462F] hover:text-[#B4462F]"
          >
            Descartar mudanças não publicadas
          </button>
        </section>
      </main>

      <!-- Barra de publicação -->
      <div
        class="fixed inset-x-0 bottom-0 z-40 border-t border-gold-soft bg-bone/95 backdrop-blur"
      >
        <div
          class="mx-auto flex w-full max-w-5xl items-center justify-between gap-4 px-5 py-3.5 sm:px-8"
        >
          <p id="estado-publicacao" class="text-[0.85rem] text-ink-muted">
            Tudo publicado.
          </p>
          <button id="btn-publicar" type="button" class="btn-clean shrink-0 text-[0.9rem]">
            Publicar
          </button>
        </div>
      </div>

      <div
        id="aviso"
        class="pointer-events-none fixed bottom-24 left-1/2 z-50 -translate-x-1/2 rounded-full bg-ink px-6 py-3 text-sm text-bone opacity-0 transition-opacity duration-300"
      >
      </div>
    </div>

    <script define:vars={{ urlGrade }}>
      /* Acesso simples: evita mexida acidental de quem tem o link.
         Não é proteção de verdade, o site é estático. */
      const USUARIO = 'quesiaadv';
      const SENHA = '123456';
      const CHAVE = 'qc-grade';
      const CHAVE_SUJO = 'qc-grade-sujo';

      const nomesDia = ['Domingo','Segunda','Terça','Quarta','Quinta','Sexta','Sábado'];
      const nomesMes = ['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'];
      const HORAS = [];
      for (let h = 7; h <= 20; h++) HORAS.push(String(h).padStart(2, '0') + ':00');

      let grade = null;
      let sujo = false;

      const iso = (d) =>
        `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;

      function avisar(texto) {
        const el = document.getElementById('aviso');
        el.textContent = texto;
        el.style.opacity = '1';
        clearTimeout(el._t);
        el._t = setTimeout(() => (el.style.opacity = '0'), 2400);
      }

      function marcarSujo(v) {
        sujo = v;
        localStorage.setItem(CHAVE_SUJO, v ? '1' : '');
        document.getElementById('selo-pendente').classList.toggle('hidden', !v);
        document.getElementById('estado-publicacao').textContent = v
          ? 'Mudanças ainda não publicadas.'
          : 'Tudo publicado.';
      }

      function salvar() {
        localStorage.setItem(CHAVE, JSON.stringify(grade));
        marcarSujo(true);
        desenhar();
      }

      async function carregar() {
        const local = localStorage.getItem(CHAVE);
        if (local) {
          try { grade = JSON.parse(local); } catch { grade = null; }
        }
        if (!grade) {
          const r = await fetch(urlGrade, { cache: 'no-store' });
          grade = await r.json();
        }
        grade.semana = grade.semana || {};
        grade.bloqueios = grade.bloqueios || [];
        grade.ocupados = grade.ocupados || [];
        marcarSujo(localStorage.getItem(CHAVE_SUJO) === '1');
        desenhar();
      }

      /* Abas */
      const abas = { dias: 'painel-dias', semana: 'painel-semana', ajustes: 'painel-ajustes' };
      function trocarAba(nome) {
        Object.entries(abas).forEach(([k, id]) => {
          document.getElementById(id).classList.toggle('hidden', k !== nome);
        });
        document.querySelectorAll('.aba').forEach((b) => {
          const on = b.dataset.aba === nome;
          b.className =
            'aba rotulo-caps border-b-2 px-4 py-3 transition-colors ' +
            (on ? 'border-gold-deep text-ink' : 'border-transparent text-ink-muted hover:text-ink');
          b.setAttribute('aria-selected', String(on));
        });
      }
      document.querySelectorAll('.aba').forEach((b) =>
        b.addEventListener('click', () => trocarAba(b.dataset.aba))
      );

      function desenhar() {
        document.getElementById('atualizado-em').textContent =
          grade.atualizadoEm || 'nunca publicada';
        document.getElementById('in-antecedencia').value = grade.antecedenciaHoras ?? 12;
        document.getElementById('in-dias').value = grade.diasFuturos ?? 30;

        /* Próximos dias */
        const px = document.getElementById('lista-dias');
        px.innerHTML = '';
        const hoje = new Date();
        hoje.setHours(0, 0, 0, 0);
        let livres = 0;
        let mostrados = 0;

        for (let i = 0; i < (grade.diasFuturos ?? 30); i++) {
          const d = new Date(hoje);
          d.setDate(d.getDate() + i);
          const chave = iso(d);
          const daSemana = (grade.semana[String(d.getDay())] || []).slice().sort();
          if (daSemana.length === 0) continue;
          mostrados++;
          const bloqueado = grade.bloqueios.includes(chave);
          const ocupadosDia = daSemana.filter((h) => grade.ocupados.includes(`${chave}T${h}`)).length;
          if (!bloqueado) livres += daSemana.length - ocupadosDia;

          const card = document.createElement('div');
          card.className = 'cartao rounded-2xl p-5' + (bloqueado ? ' opacity-55' : '');
          card.innerHTML = `
            <div class="flex flex-wrap items-center justify-between gap-3">
              <div>
                <p class="font-display text-[1.15rem] leading-tight">
                  ${nomesDia[d.getDay()]}, ${d.getDate()} de ${nomesMes[d.getMonth()]}
                </p>
                <p class="mt-0.5 text-[0.78rem] text-ink-muted">
                  ${bloqueado ? 'dia bloqueado' : `${daSemana.length - ocupadosDia} de ${daSemana.length} livres`}
                </p>
              </div>
              <button type="button" data-bloq="${chave}"
                class="rotulo-caps cursor-pointer rounded-full border px-3.5 py-1.5 transition-colors ${
                  bloqueado
                    ? 'border-[#B4462F] text-[#B4462F]'
                    : 'border-ink/15 text-ink-muted hover:border-[#B4462F] hover:text-[#B4462F]'
                }">
                ${bloqueado ? 'Liberar dia' : 'Bloquear dia'}
              </button>
            </div>
            <div class="mt-4 flex flex-wrap gap-2" data-slots="${chave}"></div>`;

          card.querySelector('[data-bloq]').addEventListener('click', () => {
            grade.bloqueios = bloqueado
              ? grade.bloqueios.filter((x) => x !== chave)
              : [...grade.bloqueios, chave];
            salvar();
          });

          const slots = card.querySelector('[data-slots]');
          daSemana.forEach((h) => {
            const id = `${chave}T${h}`;
            const ocupado = grade.ocupados.includes(id);
            const b = document.createElement('button');
            b.type = 'button';
            b.disabled = bloqueado;
            b.innerHTML = ocupado
              ? `<span class="line-through">${h}</span>`
              : h;
            b.title = ocupado ? 'Ocupado, toque para liberar' : 'Livre, toque para ocupar';
            b.className =
              'cursor-pointer rounded-lg border px-3 py-2 text-sm transition-colors ' +
              (ocupado
                ? 'border-[#B4462F]/45 bg-[#B4462F]/10 text-[#B4462F]'
                : 'border-ink/12 text-ink hover:border-gold-deep/60 hover:bg-gold/8');
            b.addEventListener('click', () => {
              grade.ocupados = ocupado
                ? grade.ocupados.filter((x) => x !== id)
                : [...grade.ocupados, id];
              salvar();
            });
            slots.appendChild(b);
          });

          px.appendChild(card);
        }

        if (mostrados === 0) {
          px.innerHTML = `<div class="cartao rounded-2xl p-6">
            <p class="text-ink-muted">Nenhum horário na grade fixa ainda.</p>
            <button type="button" id="ir-semana" class="btn-clean mt-4 text-[0.9rem]">Montar a grade</button>
          </div>`;
          document.getElementById('ir-semana')?.addEventListener('click', () => trocarAba('semana'));
        }

        document.getElementById('kpi-livres').textContent = livres;
        document.getElementById('kpi-ocupados').textContent = grade.ocupados.length;
        document.getElementById('kpi-bloqueios').textContent = grade.bloqueios.length;

        /* Grade fixa */
        const cx = document.getElementById('lista-semana');
        cx.innerHTML = '';
        for (let d = 0; d < 7; d++) {
          const ativos = grade.semana[String(d)] || [];
          const linha = document.createElement('div');
          linha.className = 'cartao rounded-2xl p-5';
          linha.innerHTML = `
            <div class="flex items-center justify-between gap-3">
              <p class="font-display text-[1.15rem]">${nomesDia[d]}</p>
              <div class="flex items-center gap-2">
                <span class="text-[0.78rem] text-ink-muted">${ativos.length ? ativos.length + ' horários' : 'sem atendimento'}</span>
                ${ativos.length ? `<button type="button" data-limpa="${d}" class="rotulo-caps cursor-pointer rounded-full px-2.5 py-1 text-ink-muted transition-colors hover:text-[#B4462F]">limpar</button>` : ''}
              </div>
            </div>
            <div class="mt-4 flex flex-wrap gap-2" data-dia="${d}"></div>`;

          linha.querySelector(`[data-limpa]`)?.addEventListener('click', () => {
            grade.semana[String(d)] = [];
            salvar();
          });

          const box = linha.querySelector('[data-dia]');
          HORAS.forEach((h) => {
            const on = ativos.includes(h);
            const b = document.createElement('button');
            b.type = 'button';
            b.textContent = h;
            b.className =
              'cursor-pointer rounded-lg border px-3 py-2 text-sm transition-colors ' +
              (on
                ? 'border-gold-deep bg-gold/15 font-medium text-gold-deep'
                : 'border-ink/12 text-ink-muted hover:border-gold-deep/50');
            b.addEventListener('click', () => {
              const lista = grade.semana[String(d)] || [];
              grade.semana[String(d)] = on
                ? lista.filter((x) => x !== h)
                : [...lista, h].sort();
              salvar();
            });
            box.appendChild(b);
          });
          cx.appendChild(linha);
        }
      }

      /* Login */
      document.getElementById('form-login').addEventListener('submit', (e) => {
        e.preventDefault();
        const u = document.getElementById('usuario').value.trim();
        const s = document.getElementById('senha').value;
        if (u === USUARIO && s === SENHA) {
          sessionStorage.setItem('qc-admin', '1');
          entrar();
        } else {
          document.getElementById('erro-login').classList.remove('hidden');
        }
      });

      function entrar() {
        document.getElementById('tela-login').style.display = 'none';
        document.getElementById('painel').classList.remove('hidden');
        trocarAba('dias');
        carregar();
      }
      if (sessionStorage.getItem('qc-admin') === '1') entrar();

      document.getElementById('btn-sair').addEventListener('click', () => {
        sessionStorage.removeItem('qc-admin');
        location.reload();
      });

      /* Ajustes */
      document.getElementById('in-antecedencia').addEventListener('change', (e) => {
        grade.antecedenciaHoras = Number(e.target.value) || 0;
        salvar();
        avisar('Antecedência atualizada');
      });
      document.getElementById('in-dias').addEventListener('change', (e) => {
        grade.diasFuturos = Number(e.target.value) || 30;
        salvar();
        avisar('Janela atualizada');
      });

      document.getElementById('btn-restaurar').addEventListener('click', async () => {
        localStorage.removeItem(CHAVE);
        localStorage.removeItem(CHAVE_SUJO);
        grade = null;
        await carregar();
        avisar('Voltou para a grade publicada');
      });

      /* Publicar */
      document.getElementById('btn-publicar').addEventListener('click', () => {
        const hoje = new Date();
        hoje.setHours(0, 0, 0, 0);
        grade.ocupados = grade.ocupados.filter((x) => new Date(x) >= hoje);
        grade.bloqueios = grade.bloqueios.filter((x) => new Date(x + 'T23:59') >= hoje);
        grade.atualizadoEm = iso(new Date());
        localStorage.setItem(CHAVE, JSON.stringify(grade));
        marcarSujo(false);
        desenhar();

        const blob = new Blob([JSON.stringify(grade, null, 2)], { type: 'application/json' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'grade.json';
        a.click();
        URL.revokeObjectURL(a.href);
        avisar('grade.json baixado. Envie ao GitHub.');
      });
    </script>
  </body>
</html>
