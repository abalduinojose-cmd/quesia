---
/**
 * Página enxuta de agendamento, feita para ser enviada aos clientes por
 * WhatsApp: abre direto na escolha da área, sem o resto do site pela frente.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  site,
  preAgendamento,
  honorarios,
  assuntosPorArea,
  iconeArea,
  avaliacoes,
} from '@/content/data';
import { withBase } from '@/lib/paths';
import Agendamento from '@/components/agendamento/Agendamento';
---

<BaseLayout
  titulo={`Agendar atendimento · ${site.nome} ${site.sufixo}`}
  descricao="Escolha a área, o assunto e o melhor horário para falar com a advogada Quesia Constâncio. Atendimento presencial em Pedro do Rio e online para todo o Brasil."
  caminho="/agendar"
>
  <div class="min-h-dvh bg-ink text-bone">
    <header class="border-b border-bone/10">
      <div
        class="mx-auto flex w-full max-w-3xl items-center justify-between gap-4 px-5 py-4 sm:px-8"
      >
        <a href={withBase('/')} class="mx-auto flex items-center gap-3">
          <img
            src={withBase('/logos/qc-mark-bone.png')}
            alt=""
            width="30"
            height="34"
            class="h-8 w-auto"
          />
          <span class="rotulo-caps text-bone-muted">{site.nome}</span>
        </a>
      </div>
    </header>

    <main class="mx-auto w-full max-w-3xl px-5 py-12 sm:px-8 sm:py-16">
      <div class="text-center">
        <p class="rotulo-caps text-gold">Agendamento</p>
        <h1
          class="mt-4 font-display text-[clamp(2rem,6vw,2.9rem)] leading-[1.08] text-bone"
        >
          Escolha o melhor <span class="texto-ouro-claro">dia e horário</span> para
          ser atendido
        </h1>
        <p class="mx-auto mt-4 max-w-xl text-[1rem] text-bone-muted">
          Leva menos de um minuto. O horário fica reservado assim que você confirma
          e a advogada retorna pelo contato que você deixar.
        </p>
      </div>

      <div class="mt-10 rounded-[calc(1.5rem+1px)] bg-gradient-to-br from-gold/45 via-bone/10 to-transparent p-px">
        <Agendamento
          client:load
          areasOpcoes={[...preAgendamento.areas]}
          assuntos={assuntosPorArea}
          modalidades={[...preAgendamento.modalidades]}
          intro={preAgendamento.intro}
          aviso={preAgendamento.aviso}
          honorarios={honorarios}
          icones={iconeArea}
          urlGrade={withBase('/grade.json')}
          foto={withBase('/sobre/quesia-640.webp')}
          advogada={`Dra. ${site.nome}`}
          oab={site.oab}
          whatsapp={site.whatsapp.numero}
        />
      </div>

      <div class="mt-12 flex flex-col gap-5 border-t border-bone/10 pt-8">
        <a
          href={avaliacoes.url}
          target="_blank"
          rel="noopener noreferrer"
          class="rotulo-caps flex items-center gap-2 text-bone-muted transition-colors hover:text-gold"
        >
          <span class="text-gold" aria-hidden="true">★</span>
          {avaliacoes.nota} no Google · {avaliacoes.total} avaliações
        </a>
        <div class="text-sm text-bone-muted">
          <p>{site.endereco.linha1}</p>
          <p>{site.endereco.linha2}</p>
        </div>
        <a
          href={withBase('/')}
          class="link-draw rotulo-caps w-fit text-gold"
        >
          Conhecer o escritório&nbsp;&nbsp;→
        </a>
      </div>
    </main>
  </div>
</BaseLayout>
