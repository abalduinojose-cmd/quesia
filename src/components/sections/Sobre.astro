---
import { sobre } from '@/content/data';
import { withBase } from '@/lib/paths';
import TituloSecao from '@/components/ui/TituloSecao.astro';
---

<section id="sobre" aria-labelledby="sobre-titulo" class="overflow-hidden bg-bone">
  <div class="mx-auto w-full max-w-[1280px] px-5 py-24 sm:px-8 lg:px-12 lg:py-32">
    <TituloSecao
      eyebrow="Sobre a advogada"
      tituloId="sobre-titulo"
    >
      Um direito que enxerga <span class="texto-ouro">pessoas</span> antes de processos
    </TituloSecao>

    <div class="mt-14 grid items-center gap-14 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        {sobre.paragrafos.map((p, i) => (
          <p class="anima medida mt-6 first:mt-0 text-ink-muted" style={`--anima-delay: ${i * 90}ms`}>
            {p}
          </p>
        ))}

        <div class="anima mt-10 border-t border-gold-soft pt-8" style="--anima-delay: 300ms">
          <p class="rotulo-caps text-gold-deep">{sobre.especialista}</p>
          <p class="mt-3 font-display text-[1.5rem] italic leading-snug text-ink">
            {sobre.fecho}
          </p>
        </div>
      </div>

      <figure class="anima relative mx-auto w-full max-w-[360px] lg:col-span-5" style="--anima-delay: 150ms">
        <div
          class="absolute -inset-4 rounded-[2rem] border border-gold-soft"
          aria-hidden="true"
        >
        </div>
        <div class="relative aspect-[3/4] overflow-hidden rounded-3xl shadow-[0_28px_60px_-30px_rgb(36_36_36/0.45)]">
          <picture>
            <source
              type="image/avif"
              srcset={`${withBase('/sobre/quesia-640.avif')} 640w, ${withBase('/sobre/quesia-960.avif')} 960w`}
              sizes="(min-width: 1024px) 360px, 86vw"
            />
            <img
              src={withBase('/sobre/quesia-960.webp')}
              srcset={`${withBase('/sobre/quesia-640.webp')} 640w, ${withBase('/sobre/quesia-960.webp')} 960w`}
              sizes="(min-width: 1024px) 360px, 86vw"
              alt="Dra. Quesia Constâncio"
              width="960"
              height="1280"
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover"
            />
          </picture>
        </div>
        <figcaption class="rotulo-caps mt-5 text-center text-ink-muted">
          {sobre.legendaFoto}
        </figcaption>
      </figure>
    </div>
  </div>
</section>
