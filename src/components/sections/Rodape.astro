---
import { site, rodape, capitulos, avaliacoes } from '@/content/data';
import { withBase } from '@/lib/paths';
import { waLink, waMensagemPadrao } from '@/lib/wa';
import IconeWhats from '@/components/ui/IconeWhats.astro';

const ano = new Date().getFullYear();

const redes = [
  {
    nome: 'Instagram',
    url: site.social.instagram,
    d: 'M7.5 2h9A5.5 5.5 0 0 1 22 7.5v9a5.5 5.5 0 0 1-5.5 5.5h-9A5.5 5.5 0 0 1 2 16.5v-9A5.5 5.5 0 0 1 7.5 2Zm0 2A3.5 3.5 0 0 0 4 7.5v9A3.5 3.5 0 0 0 7.5 20h9a3.5 3.5 0 0 0 3.5-3.5v-9A3.5 3.5 0 0 0 16.5 4h-9ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm5.3-3.1a1.05 1.05 0 1 1 0 2.1 1.05 1.05 0 0 1 0-2.1Z',
  },
  {
    nome: 'Facebook',
    url: site.social.facebook,
    d: 'M13.5 21v-7.2h2.4l.4-2.8h-2.8V9.2c0-.8.2-1.4 1.4-1.4h1.5V5.3c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8V11H8.1v2.8h2.4V21h3Z',
  },
  {
    nome: 'Como chegar',
    url: site.endereco.mapsUrl,
    d: 'M12 2a7 7 0 0 1 7 7c0 4.4-4.6 9.9-6.3 11.8a1 1 0 0 1-1.4 0C9.6 18.9 5 13.4 5 9a7 7 0 0 1 7-7Zm0 2a5 5 0 0 0-5 5c0 2.9 2.9 7 5 9.5 2.1-2.5 5-6.6 5-9.5a5 5 0 0 0-5-5Zm0 2.6a2.4 2.4 0 1 1 0 4.8 2.4 2.4 0 0 1 0-4.8Z',
  },
];
---

<footer class="relative isolate overflow-hidden bg-ink text-bone">
  <div
    class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-gold/70 to-transparent"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute inset-0 bg-[radial-gradient(100%_70%_at_85%_0%,rgb(201_168_81/0.10),transparent_60%)]"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto w-full max-w-[1280px] px-5 sm:px-8 lg:px-12">
    <!-- Chamada final -->
    <div
      class="flex flex-col items-start justify-between gap-8 border-b border-bone/10 py-14 lg:flex-row lg:items-end lg:py-16"
    >
      <div>
        <p class="rotulo-caps text-gold">Vamos começar</p>
        <p
          class="mt-4 max-w-xl font-display text-[clamp(1.9rem,3.8vw,2.85rem)] leading-[1.08]"
        >
          Seu direito merece <span class="texto-ouro-claro">atenção de verdade</span>
        </p>
      </div>
      <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
        <a href={withBase('/agendar')} class="btn-clean justify-center text-[0.95rem]">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M8 3v3m8-3v3M3.5 9.5h17M5 6h14a1.5 1.5 0 0 1 1.5 1.5V19A1.5 1.5 0 0 1 19 20.5H5A1.5 1.5 0 0 1 3.5 19V7.5A1.5 1.5 0 0 1 5 6Z"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
            ></path>
          </svg>
          Agendar atendimento
        </a>
        <a
          href={waLink(waMensagemPadrao)}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-2.5 rounded-full border border-bone/25 px-6 py-3.5 text-[0.95rem] text-bone transition-colors duration-300 hover:border-[#25D366] hover:text-[#25D366]"
        >
          <IconeWhats tamanho={17} />
          WhatsApp
        </a>
      </div>
    </div>

    <!-- Colunas -->
    <div class="grid gap-12 py-14 md:grid-cols-12 md:gap-8">
      <div class="md:col-span-5">
        <img
          src={withBase('/logos/qc-mark-bone.png')}
          alt=""
          width="52"
          height="60"
          loading="lazy"
          decoding="async"
          class="h-14 w-auto"
        />
        <p class="mt-5 font-display text-[1.4rem] leading-tight">{site.nome}</p>
        <p class="rotulo-caps mt-1.5 text-bone-muted">{site.sufixo} · {site.oab}</p>
        <a
          href={avaliacoes.url}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex items-center gap-2 rounded-full border border-gold/25 bg-gold/[0.07] px-4 py-2 text-[0.8rem] text-gold transition-colors hover:border-gold/60"
        >
          <span aria-hidden="true">★</span>
          {avaliacoes.nota} no Google · {avaliacoes.total} avaliações
        </a>
      </div>

      <nav class="md:col-span-3" aria-label="Navegação do rodapé">
        <p class="rotulo-caps text-gold">Navegação</p>
        <ul class="mt-5 flex flex-col gap-2.5" role="list">
          {capitulos.map((c) => (
            <li>
              <a
                href={`#${c.id}`}
                class="link-draw text-[0.92rem] text-bone-muted transition-colors hover:text-bone"
              >
                {c.curto}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="md:col-span-4">
        <p class="rotulo-caps text-gold">Contato</p>
        <address class="mt-5 flex flex-col gap-3 not-italic text-[0.92rem] text-bone-muted">
          <a
            href={waLink(waMensagemPadrao)}
            target="_blank"
            rel="noopener noreferrer"
            class="link-draw w-fit font-display text-[1.35rem] text-bone"
          >
            {site.whatsapp.display}
          </a>
          <span>
            {site.endereco.linha1}<br />
            {site.endereco.linha2}
          </span>
        </address>

        <div class="mt-6 flex items-center gap-2.5">
          {redes.map((r) => (
            <a
              href={r.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${r.nome}, abre em nova aba`}
              class="flex h-10 w-10 items-center justify-center rounded-full bg-white/[0.06] text-bone-muted transition-all duration-300 hover:-translate-y-0.5 hover:bg-gold hover:text-ink"
            >
              <svg width="17" height="17" viewBox="0 0 24 24" aria-hidden="true">
                <path d={r.d} fill="currentColor"></path>
              </svg>
            </a>
          ))}
          <a
            href={waLink(waMensagemPadrao)}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp, abre em nova aba"
            class="flex h-10 w-10 items-center justify-center rounded-full bg-white/[0.06] text-bone-muted transition-all duration-300 hover:-translate-y-0.5 hover:bg-[#25D366] hover:text-white"
          >
            <IconeWhats tamanho={17} />
          </a>
        </div>
      </div>
    </div>

    <!-- Avisos e legais -->
    <div class="flex flex-col gap-6 border-t border-bone/10 py-9">
      <div class="flex max-w-4xl flex-col gap-2">
        {rodape.avisos.map((a) => (
          <p class="text-[0.76rem] leading-relaxed text-bone-muted/75">{a}</p>
        ))}
      </div>
      <div class="flex flex-wrap items-center justify-between gap-4">
        <p class="text-[0.76rem] text-bone-muted">
          © {ano} {site.nome} {site.sufixo}
        </p>
        <a
          href={withBase('/privacidade')}
          class="link-draw text-[0.76rem] text-bone-muted transition-colors hover:text-bone"
        >
          Política de privacidade
        </a>
      </div>
    </div>
  </div>
</footer>
