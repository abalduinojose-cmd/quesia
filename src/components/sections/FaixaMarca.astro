---
/** Faixa de endereço: aparece SÓ no mobile (md:hidden). */
import { site } from '@/content/data';
---

<section
  aria-label="Endereço do escritório"
  class="relative isolate overflow-hidden bg-ink md:hidden"
>
  <!-- Fundo escuro com brilho quente sutil, sem imagem -->
  <div
    class="absolute inset-0 bg-[radial-gradient(120%_80%_at_15%_0%,rgb(201_168_81/0.14),transparent_60%)]"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-black/50 to-transparent"
    aria-hidden="true"
  >
  </div>

  <div class="relative flex flex-col gap-4 px-6 py-16 text-bone">
    <span class="regua-tick" aria-hidden="true"></span>
    <p class="font-display text-[2rem] leading-[1.12]">
      Um escritório com <span class="texto-ouro-claro">nome, rosto e endereço</span>
    </p>
    <p class="text-[0.97rem] leading-relaxed text-bone-muted">
      {site.endereco.linha1}, {site.endereco.linha2}. Atendimento presencial e
      online para todo o Brasil.
    </p>
    <a
      href={site.endereco.mapsUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="link-draw rotulo-caps mt-1 flex w-fit items-center gap-2 text-gold"
    >
      <svg width="15" height="15" viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M12 2a7 7 0 0 1 7 7c0 4.4-4.6 9.9-6.3 11.8a1 1 0 0 1-1.4 0C9.6 18.9 5 13.4 5 9a7 7 0 0 1 7-7Zm0 2a5 5 0 0 0-5 5c0 2.9 2.9 7 5 9.5 2.1-2.5 5-6.6 5-9.5a5 5 0 0 0-5-5Zm0 2.6a2.4 2.4 0 1 1 0 4.8 2.4 2.4 0 0 1 0-4.8Z"
          fill="currentColor"
        ></path>
      </svg>
      Ver rota no Google Maps
    </a>
  </div>
</section>
