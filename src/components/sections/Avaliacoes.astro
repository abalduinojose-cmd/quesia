---
import { avaliacoes, numeroCapitulo } from '@/content/data';
import TituloSecao from '@/components/ui/TituloSecao.astro';
import Selo from '@/components/capa/Selo.astro';
---

{
  avaliacoes.exibir ? (
    <section id="avaliacoes" aria-labelledby="avaliacoes-titulo" class="overflow-hidden bg-bone">
      <div class="mx-auto w-full max-w-[1280px] px-5 py-24 sm:px-8 lg:px-12 lg:py-32">
        <div class="flex flex-wrap items-end justify-between gap-10">
          <TituloSecao
            numero={numeroCapitulo('avaliacoes')}
            eyebrow="O que dizem os clientes"
            tituloId="avaliacoes-titulo"
          >
            Nota <span class="texto-ouro">5,0 no Google</span>, com {avaliacoes.total} avaliações
          </TituloSecao>

          <div class="anima hidden items-center gap-3 md:flex" style="--anima-delay: 150ms">
            <button
              id="aval-ant"
              type="button"
              aria-label="Depoimentos anteriores"
              class="flex h-12 w-12 cursor-pointer items-center justify-center rounded-full border border-ink/25 text-ink transition-colors duration-300 hover:border-gold-deep hover:text-gold-deep"
            >
              <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M10 2 4 8l6 6" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </button>
            <button
              id="aval-prox"
              type="button"
              aria-label="Próximos depoimentos"
              class="flex h-12 w-12 cursor-pointer items-center justify-center rounded-full border border-ink/25 text-ink transition-colors duration-300 hover:border-gold-deep hover:text-gold-deep"
            >
              <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M6 2l6 6-6 6" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </button>
          </div>
        </div>

        <div
          id="trilho-avaliacoes"
          class="carrossel sem-scrollbar anima mt-14"
          style="--anima-delay: 120ms"
          role="list"
          aria-label="Depoimentos de clientes no Google"
        >
          {avaliacoes.itens.map((a) => (
            <article
              role="listitem"
              class="cartao flex flex-col gap-5 rounded-3xl p-7"
            >
              <div class="flex items-center justify-between">
                <p class="text-gold-deep" aria-label={`${a.nota} de 5 estrelas`}>
                  {'★'.repeat(a.nota)}
                </p>
                <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" class="opacity-70">
                  <path d="M12 10.2v3.9h5.5a4.7 4.7 0 0 1-2 3.1l3.2 2.5c1.9-1.7 3-4.3 3-7.3 0-.7-.1-1.5-.2-2.2H12Zm-6.6 4.6a6.6 6.6 0 0 1 0-5.6L2.1 6.6a11 11 0 0 0 0 10.8l3.3-2.6ZM12 22c3 0 5.5-1 7.3-2.7l-3.2-2.5c-.9.6-2.1 1-4.1 1a7 7 0 0 1-6.6-4.6L2.1 15.8A11 11 0 0 0 12 22Zm0-17.6c1.6 0 3.1.6 4.2 1.7l3.1-3.1A11 11 0 0 0 2.1 6.6l3.3 2.6A7 7 0 0 1 12 4.4Z" fill="#8A6E2B"></path>
                </svg>
              </div>
              <p class="text-[0.96rem] leading-relaxed text-ink-muted">{a.texto}</p>
              <div class="mt-auto flex items-center gap-4 border-t border-gold-soft pt-5">
                {a.foto ? (
                  <img
                    src={a.foto}
                    alt=""
                    width="44"
                    height="44"
                    referrerpolicy="no-referrer"
                    decoding="async"
                    class="h-11 w-11 rounded-full object-cover"
                  />
                ) : (
                  <span
                    class="flex h-11 w-11 items-center justify-center rounded-full border border-gold/50 bg-bone font-display text-ink"
                    aria-hidden="true"
                  >
                    {a.nome.charAt(0)}
                  </span>
                )}
                <div>
                  <p class="text-sm font-medium text-ink">{a.nome}</p>
                  <p class="rotulo-caps mt-0.5 text-ink-muted">{a.data}</p>
                </div>
              </div>
            </article>
          ))}

          <a
            role="listitem"
            href={avaliacoes.url}
            target="_blank"
            rel="noopener noreferrer"
            class="cartao-vivo cartao flex flex-col items-center justify-center gap-6 rounded-3xl p-7 text-center"
          >
            <Selo sufixoId="carrossel" tamanho={118} />
            <p class="font-display text-[1.35rem] leading-snug text-ink">
              Veja as {avaliacoes.total} avaliações no Google
            </p>
            <span class="link-draw rotulo-caps text-gold-deep">Abrir perfil&nbsp;&nbsp;→</span>
          </a>
        </div>

        <p class="anima mt-8 text-sm text-ink-muted">
          Depoimentos públicos de usuários no perfil da advogada no Google, reproduzidos na íntegra.
        </p>
      </div>
    </section>
  ) : null
}

<script>
  const trilho = document.getElementById('trilho-avaliacoes');
  if (trilho) {
    const passo = () => {
      const card = trilho.querySelector<HTMLElement>('article');
      return (card?.offsetWidth ?? 320) + 20;
    };
    document.getElementById('aval-ant')?.addEventListener('click', () => {
      trilho.scrollBy({ left: -passo(), behavior: 'smooth' });
    });
    document.getElementById('aval-prox')?.addEventListener('click', () => {
      trilho.scrollBy({ left: passo(), behavior: 'smooth' });
    });

    /* Arraste com o mouse (no toque o scroll nativo já resolve) */
    let arrastando = false;
    let moveu = false;
    let x0 = 0;
    let scroll0 = 0;
    trilho.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse') return;
      arrastando = true;
      moveu = false;
      x0 = e.clientX;
      scroll0 = trilho.scrollLeft;
      trilho.setPointerCapture(e.pointerId);
    });
    trilho.addEventListener('pointermove', (e) => {
      if (!arrastando) return;
      const dx = e.clientX - x0;
      if (Math.abs(dx) > 6) {
        moveu = true;
        trilho.classList.add('arrastando');
      }
      trilho.scrollLeft = scroll0 - dx;
    });
    const soltar = (e: PointerEvent) => {
      if (!arrastando) return;
      arrastando = false;
      trilho.classList.remove('arrastando');
      if (trilho.hasPointerCapture(e.pointerId)) trilho.releasePointerCapture(e.pointerId);
    };
    trilho.addEventListener('pointerup', soltar);
    trilho.addEventListener('pointercancel', soltar);
    /* Evita abrir o link do último cartão após um arraste */
    trilho.addEventListener('click', (e) => {
      if (moveu) {
        e.preventDefault();
        e.stopPropagation();
        moveu = false;
      }
    }, true);
  }
</script>
