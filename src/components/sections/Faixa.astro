---
import { avaliacoes } from '@/content/data';

const stats = [
  {
    valor: '5,0',
    estrela: true,
    rotulo: `${avaliacoes.total} avaliações no Google`,
    href: avaliacoes.url,
    contar: null,
  },
  { valor: '237.540', estrela: false, rotulo: 'Inscrição OAB/RJ', href: null, contar: null },
  { valor: 'Pedro do Rio', estrela: false, rotulo: 'Petrópolis · RJ', href: null, contar: null },
  {
    valor: 'Presencial e online',
    estrela: false,
    rotulo: 'Atendimento em todo o Brasil',
    href: null,
    contar: null,
  },
];
---

<section aria-label="Credenciais em números" class="bg-ink text-bone">
  <div
    class="mx-auto grid w-full max-w-[1280px] grid-cols-2 gap-3 px-5 py-14 sm:gap-4 sm:px-8 lg:px-12 lg:py-16"
  >
    {stats.map((s, i) => {
      const Tag = s.href ? 'a' : 'div';
      return (
        <Tag
          class="cartao-escuro anima group flex flex-col justify-between gap-4 rounded-2xl p-5 transition-[border-color,transform,background-color] duration-300 hover:-translate-y-1 hover:border-gold/50 hover:bg-white/[0.05] sm:p-7"
          style={`--anima-delay: ${i * 90}ms`}
          {...(s.href
            ? { href: s.href, target: '_blank', rel: 'noopener noreferrer' }
            : {})}
        >
          <p
            class="texto-ouro-claro font-display text-[clamp(1.2rem,4.2vw,2.05rem)] leading-[1.12]"
          >
            {s.valor}
            {s.estrela && <span aria-hidden="true"> ★</span>}
          </p>
          <div class="flex items-end justify-between gap-2">
            <p class="rotulo-caps text-[0.58rem] leading-snug tracking-[0.14em] text-bone-muted sm:text-[0.7rem] sm:tracking-[var(--tracking-caps)]">
              {s.rotulo}
            </p>
            {s.href && (
              <span
                class="shrink-0 text-gold transition-transform duration-300 group-hover:translate-x-1"
                aria-hidden="true"
              >
                →
              </span>
            )}
          </div>
        </Tag>
      );
    })}
  </div>
</section>
