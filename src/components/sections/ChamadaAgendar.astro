---
/** Chamada de ênfase para o agendamento, entre o Sobre e a agenda. */
import { avaliacoes } from '@/content/data';
---

<section aria-label="Agende seu atendimento" class="bg-bone">
  <div class="mx-auto w-full max-w-[1280px] px-5 pb-24 sm:px-8 lg:px-12">
    <div
      class="anima relative isolate overflow-hidden rounded-3xl bg-ink px-7 py-12 text-bone sm:px-12 sm:py-14"
    >
      <div
        class="absolute inset-0 bg-[radial-gradient(120%_90%_at_10%_0%,rgb(201_168_81/0.20),transparent_62%)]"
        aria-hidden="true"
      >
      </div>

      <div
        class="relative flex flex-col items-start gap-9 lg:flex-row lg:items-center lg:justify-between lg:gap-14"
      >
        <div class="max-w-xl">
          <p class="rotulo-caps text-gold">Agenda aberta</p>
          <p
            class="mt-4 font-display text-[clamp(1.9rem,3.6vw,2.75rem)] leading-[1.1]"
          >
            Escolha o <span class="texto-ouro-claro">dia e a hora</span> que cabem na
            sua rotina
          </p>
          <p class="medida mt-4 text-[1rem] text-bone-muted">
            A agenda mostra os horários livres da advogada. Você escolhe, o horário
            fica reservado na hora e a confirmação vem em seguida.
          </p>
        </div>

        <div class="flex w-full shrink-0 flex-col gap-4 sm:w-auto">
          <a href="#agendamento" class="btn-clean w-full justify-center text-[0.98rem] sm:w-auto sm:px-9">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M8 3v3m8-3v3M3.5 9.5h17M5 6h14a1.5 1.5 0 0 1 1.5 1.5V19A1.5 1.5 0 0 1 19 20.5H5A1.5 1.5 0 0 1 3.5 19V7.5A1.5 1.5 0 0 1 5 6Z"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
              ></path>
            </svg>
            Ver horários disponíveis
          </a>
          <a
            href={avaliacoes.url}
            target="_blank"
            rel="noopener noreferrer"
            class="rotulo-caps flex items-center justify-center gap-2 text-bone-muted transition-colors hover:text-gold sm:justify-start"
          >
            <span class="text-gold" aria-hidden="true">★</span>
            {avaliacoes.nota} no Google · {avaliacoes.total} avaliações
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
