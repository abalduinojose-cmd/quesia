---
import { areas, numeroCapitulo } from '@/content/data';
import TituloSecao from '@/components/ui/TituloSecao.astro';

/* Ícones stroke fino (1.5) por área */
const icones: Record<string, string> = {
  previdenciario:
    'M12 3c3.5 2.2 6.8 2.6 9 2.6 0 7.8-3.4 13-9 15.4C6.4 18.6 3 13.4 3 5.6c2.2 0 5.5-.4 9-2.6Zm-3 9.2 2.2 2.2L15 10.6',
  imobiliario:
    'M3.5 11 12 4l8.5 7M6 9.5V20h12V9.5M9.8 20v-6h4.4v6',
  sucessorio:
    'M12 4.5a2.6 2.6 0 1 1 0 5.2 2.6 2.6 0 0 1 0-5.2ZM5.5 14.3a2.4 2.4 0 1 1 0 4.8 2.4 2.4 0 0 1 0-4.8Zm13 0a2.4 2.4 0 1 1 0 4.8 2.4 2.4 0 0 1 0-4.8ZM12 9.7v3m0 0-4.6 2.6M12 12.7l4.6 2.6',
};
---

<section id="areas" aria-labelledby="areas-titulo" class="overflow-hidden bg-bone">
  <div class="mx-auto w-full max-w-[1280px] px-5 py-24 sm:px-8 lg:px-12 lg:py-32">
    <TituloSecao
      numero={numeroCapitulo('areas')}
      eyebrow="Áreas de atuação"
      tituloId="areas-titulo"
    >
      O direito do <span class="texto-ouro">sustento</span>, do lar e da herança
    </TituloSecao>

    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {areas.map((a, i) => (
        <article
          class="cartao cartao-vivo anima flex flex-col rounded-3xl p-8"
          style={`--anima-delay: ${i * 110}ms`}
          aria-label={a.titulo}
        >
          <span
            class="flex h-14 w-14 items-center justify-center rounded-2xl border border-gold/40 bg-bone text-gold-deep"
            aria-hidden="true"
          >
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none">
              <path
                d={icones[a.id]}
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
            </svg>
          </span>

          <h3 class="mt-6 font-display text-[1.55rem] leading-snug text-ink">
            {a.titulo}
          </h3>
          <p class="mt-3 text-[0.95rem] text-ink-muted">{a.lede}</p>

          <ul class="mt-6 flex flex-col gap-3" role="list">
            {a.topicos.map((t) => (
              <li class="flex items-baseline gap-3 text-[0.94rem] text-ink">
                <span
                  class="h-[5px] w-[5px] shrink-0 -translate-y-[1px] rounded-full bg-gold"
                  aria-hidden="true"
                >
                </span>
                {t}
              </li>
            ))}
          </ul>

          <a
            href="#agendamento"
            data-abre-area={a.tituloCurto}
            class="link-draw rotulo-caps mt-8 inline-block pt-2 text-gold-deep"
          >
            Falar sobre {a.tituloCurto}&nbsp;&nbsp;→
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  /* Cada cartão leva ao agendamento com a área já marcada, então na seção a
     pessoa só escolhe o tema. Sem JS, o link ainda rola até o agendamento. */
  document.querySelectorAll<HTMLAnchorElement>('[data-abre-area]').forEach((a) => {
    a.addEventListener('click', () => {
      window.dispatchEvent(
        new CustomEvent('qc:area', { detail: a.dataset.abreArea })
      );
    });
  });
</script>
