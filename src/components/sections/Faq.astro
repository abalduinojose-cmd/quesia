---
import { faq } from '@/content/data';
import TituloSecao from '@/components/ui/TituloSecao.astro';
---

<section id="faq" aria-labelledby="faq-titulo" class="overflow-hidden bg-bone-dim">
  <div class="mx-auto w-full max-w-[1280px] px-5 py-24 sm:px-8 lg:px-12 lg:py-32">
    <div class="grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <TituloSecao
          eyebrow="Perguntas frequentes"
          tituloId="faq-titulo"
        >
          Dúvidas que chegam <span class="texto-ouro">todos os dias</span>
        </TituloSecao>

        <div
          class="cartao anima mt-10 rounded-2xl p-7"
          style="--anima-delay: 160ms"
        >
          <p class="font-display text-[1.3rem] leading-snug text-ink">
            Não achou a sua dúvida?
          </p>
          <p class="mt-2 text-[0.95rem] text-ink-muted">
            Marque um horário e pergunte direto para a advogada.
          </p>
          <a href="#agendamento" class="btn-clean mt-5 text-[0.9rem]">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M8 3v3m8-3v3M3.5 9.5h17M5 6h14a1.5 1.5 0 0 1 1.5 1.5V19A1.5 1.5 0 0 1 19 20.5H5A1.5 1.5 0 0 1 3.5 19V7.5A1.5 1.5 0 0 1 5 6Z"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"></path>
            </svg>
            Agendar atendimento
          </a>
        </div>
      </div>

      <div class="lg:col-span-8">
        {faq.map((f, i) => (
          <details
            class="acordeao cartao anima mb-4 rounded-2xl px-7"
            style={`--anima-delay: ${i * 60}ms`}
            open={i === 0}
          >
            <summary class="flex items-center justify-between gap-5 py-6">
              <span class="flex items-baseline gap-4">
                <span class="texto-ouro font-display italic text-[1.15rem]" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="font-display text-[1.22rem] leading-snug text-ink sm:text-[1.35rem]">
                  {f.pergunta}
                </span>
              </span>
              <span
                class="acordeao-icone flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-gold/40 text-gold-deep"
                aria-hidden="true"
              >
                <svg width="12" height="12" viewBox="0 0 12 12">
                  <path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
                </svg>
              </span>
            </summary>
            <p class="medida border-t border-gold-soft pb-7 pt-5 text-[0.97rem] text-ink-muted sm:pl-11">
              {f.resposta}
            </p>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>
