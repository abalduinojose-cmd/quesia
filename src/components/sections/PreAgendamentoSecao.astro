---
import { site, preAgendamento, numeroCapitulo } from '@/content/data';
import { withBase } from '@/lib/paths';
import TituloSecao from '@/components/ui/TituloSecao.astro';
import Agendamento from '@/components/agendamento/Agendamento';

const passos = [
  {
    n: '01',
    t: 'Escolha a área',
    d: 'Previdenciário, Imobiliário, Sucessório ou outro assunto.',
  },
  {
    n: '02',
    t: 'Diga como prefere ser atendido',
    d: 'Presencial em Pedro do Rio, online ou qualquer uma das opções.',
  },
  {
    n: '03',
    t: 'Escolha dia e horário',
    d: 'A agenda mostra só os horários realmente livres.',
  },
  {
    n: '04',
    t: 'Confirme pelo WhatsApp',
    d: 'A mensagem chega pronta e a advogada confirma com você.',
  },
];
---

<section
  id="pre-agendamento"
  aria-labelledby="pre-agendamento-titulo"
  class="overflow-hidden bg-ink text-bone"
>
  <div class="mx-auto w-full max-w-[1280px] px-5 py-24 sm:px-8 lg:px-12 lg:py-32">
    <TituloSecao
      numero={numeroCapitulo('pre-agendamento')}
      eyebrow="Agendamento"
      tema="escuro"
      tituloId="pre-agendamento-titulo"
    >
      Agende seu atendimento em <span class="texto-ouro-claro">poucos toques</span>
    </TituloSecao>

    <div class="mt-14 grid gap-14 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <p class="anima medida-curta text-bone-muted">{preAgendamento.intro}</p>

        <ol class="mt-10 flex flex-col gap-7" role="list">
          {passos.map((p, i) => (
            <li class="anima flex gap-5" style={`--anima-delay: ${i * 100}ms`}>
              <span
                class="texto-ouro-claro font-display italic text-[1.6rem] leading-none"
                aria-hidden="true"
              >
                {p.n}
              </span>
              <div>
                <p class="font-display text-[1.24rem] leading-snug text-bone">{p.t}</p>
                <p class="mt-1.5 text-[0.93rem] text-bone-muted">{p.d}</p>
              </div>
            </li>
          ))}
        </ol>

        <p class="anima rotulo-caps mt-11 text-bone-muted" style="--anima-delay: 420ms">
          Confirmação pelo WhatsApp {site.whatsapp.display}
        </p>
      </div>

      <div class="anima lg:col-span-7" style="--anima-delay: 140ms">
        <div class="rounded-[calc(1.5rem+1px)] bg-gradient-to-br from-gold/45 via-bone/10 to-transparent p-px shadow-[0_30px_70px_-40px_rgb(0_0_0/0.9)]">
          <Agendamento
            client:load
            areasOpcoes={[...preAgendamento.areas]}
            modalidades={[...preAgendamento.modalidades]}
            intro={preAgendamento.intro}
            aviso={preAgendamento.aviso}
            numeroWhats={site.whatsapp.numero}
            urlGrade={withBase('/grade.json')}
          />
        </div>
      </div>
    </div>
  </div>
</section>
