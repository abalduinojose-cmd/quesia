---
/**
 * Seção de agendamento remodelada seguindo o guia de estética de frontend do
 * cookbook da Anthropic: fundo com atmosfera em camadas no lugar de cor
 * chapada, tipografia com contraste extremo (numeral gigante e fino contra
 * título compacto), dourado como acento afiado e não distribuído, e uma
 * entrada única e orquestrada com atraso escalonado.
 */
import {
  site,
  preAgendamento,
  honorarios,
  assuntosPorArea,
  iconeArea,
  numeroCapitulo,
} from '@/content/data';
import { withBase } from '@/lib/paths';
import TituloSecao from '@/components/ui/TituloSecao.astro';
import Agendamento from '@/components/agendamento/Agendamento';

const passos = [
  {
    n: '01',
    t: 'Escolha a área e o tema',
    d: 'Da aposentadoria ao inventário, incluindo consultoria, holding e tributário.',
  },
  {
    n: '02',
    t: 'Diga como prefere ser atendida',
    d: 'Presencial em Pedro do Rio, online ou qualquer uma das opções.',
  },
  {
    n: '03',
    t: 'Escolha dia e horário',
    d: 'A agenda mostra só os horários realmente livres.',
  },
  {
    n: '04',
    t: 'Confirme o valor da consulta',
    d: `A consulta particular custa ${honorarios.valor}, combinado direto com a advogada.`,
  },
  {
    n: '05',
    t: 'Deixe nome e contato',
    d: 'O horário sai da agenda na hora e a advogada confirma com você.',
  },
];
---

<section
  id="agendamento"
  aria-labelledby="agendamento-titulo"
  class="atmosfera-agenda relative overflow-hidden bg-ink text-bone"
>
  <!-- Camadas de fundo: brilho dourado, malha fina e fio de luz no topo -->
  <div class="brilho-agenda" aria-hidden="true"></div>
  <div class="malha-agenda" aria-hidden="true"></div>
  <div class="fio-luz" aria-hidden="true"></div>

  <div
    class="relative z-10 mx-auto w-full max-w-[1280px] px-5 py-24 sm:px-8 lg:px-12 lg:py-32"
  >
    <TituloSecao
      numero={numeroCapitulo('agendamento')}
      eyebrow="Agendamento"
      tema="escuro"
      tituloId="agendamento-titulo"
    >
      Agende seu atendimento em <span class="texto-ouro-claro">poucos toques</span>
    </TituloSecao>

    <div class="mt-16 grid gap-16 lg:grid-cols-12 lg:gap-14 xl:gap-16">
      <div class="lg:col-span-5">
        <p class="anima medida-curta text-[1.02rem] leading-relaxed text-bone-muted">
          {preAgendamento.intro}
        </p>

        <!-- Trilha vertical: fio dourado ligando os cinco passos -->
        <ol class="trilha mt-12" role="list">
          {passos.map((p, i) => (
            <li class="anima-passo trilha-item" style={`--anima-delay: ${140 + i * 90}ms`}>
              <span class="trilha-no" aria-hidden="true"></span>
              <span class="trilha-numero" aria-hidden="true">{p.n}</span>
              <div class="trilha-texto">
                <p class="font-display text-[1.3rem] leading-tight text-bone">{p.t}</p>
                <p class="mt-2 text-[0.92rem] leading-relaxed text-bone-muted">{p.d}</p>
              </div>
            </li>
          ))}
        </ol>

        <a
          href={`https://wa.me/${site.whatsapp.numero}`}
          target="_blank"
          rel="noopener noreferrer"
          class="anima-passo selo-whats mt-12"
          style="--anima-delay: 620ms"
        >
          <span class="pulso-verde" aria-hidden="true"></span>
          <span class="rotulo-caps">Prefere falar antes?</span>
          <span class="font-display text-[1.05rem] leading-none text-bone">
            {site.whatsapp.display}
          </span>
        </a>
      </div>

      <div class="anima relative lg:col-span-7" style="--anima-delay: 220ms">
        <!-- Halo dourado atrás do cartão, para ele virar o foco da seção -->
        <div class="halo-wizard" aria-hidden="true"></div>
        <div
          class="relative rounded-[calc(1.5rem+1px)] bg-gradient-to-br from-gold/55 via-bone/10 to-transparent p-px shadow-[0_40px_90px_-45px_rgb(0_0_0/0.95)]"
        >
          <Agendamento
            client:load
            areasOpcoes={[...preAgendamento.areas]}
            assuntos={assuntosPorArea}
            modalidades={[...preAgendamento.modalidades]}
            intro={preAgendamento.intro}
            aviso={preAgendamento.aviso}
            honorarios={honorarios}
            icones={iconeArea}
            numeroWhats={site.whatsapp.numero}
            urlGrade={withBase('/grade.json')}
            foto={withBase('/sobre/quesia-640.webp')}
            advogada={`Dra. ${site.nome}`}
            oab={site.oab}
          />
        </div>
      </div>
    </div>
  </div>
</section>
