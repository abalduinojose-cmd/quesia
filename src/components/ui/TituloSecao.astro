---
/**
 * Cabeçalho de seção: eyebrow dourado + título display (conteúdo via slot,
 * para permitir spans .texto-ouro).
 *
 * A numeração gigante apagada ao fundo saiu: contar seção não ajuda quem lê e
 * o numeral competia com o próprio título.
 */
interface Props {
  eyebrow: string;
  tema?: 'claro' | 'escuro';
  alinhar?: 'esq' | 'dir';
  tituloId?: string;
}
const { eyebrow, tema = 'claro', alinhar = 'esq', tituloId } = Astro.props;
---

<div class={`relative ${alinhar === 'dir' ? 'text-right' : ''}`}>
  <p
    class={`rotulo-caps anima relative z-10 ${tema === 'escuro' ? 'text-gold' : 'text-gold-deep'}`}
  >
    {eyebrow}
  </p>
  <h2
    id={tituloId}
    class={`anima relative z-10 mt-4 font-display text-[clamp(2.1rem,4.2vw,3.35rem)] leading-[1.06] ${
      tema === 'escuro' ? 'text-bone' : 'text-ink'
    } ${alinhar === 'dir' ? 'ml-auto' : ''} max-w-3xl`}
    style="--anima-delay: 80ms"
  >
    <slot />
  </h2>
</div>
