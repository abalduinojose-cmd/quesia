   com área, modalidade e nome já preenchidos. */
import IconeWhats from '@/components/ui/IconeWhats.astro';
---

<a
  href="#agendamento"
  class="fab-whats fab-pulso"
  aria-label="Fazer agendamento pelo WhatsApp"
>
