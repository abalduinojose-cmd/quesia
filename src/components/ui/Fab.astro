   com área, modalidade e nome já preenchidos. */
import IconeWhats from '@/components/ui/IconeWhats.astro';
---

<a
  href="#pre-agendamento"
  class="fab-whats fab-pulso"
  aria-label="Fazer pré-agendamento pelo WhatsApp"
>
  <IconeWhats tamanho={23} />
  <span class="fab-rotulo rotulo-caps">Fazer pré-agendamento</span>
</a>
