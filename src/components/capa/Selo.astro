---
import { avaliacoes, site } from '@/content/data';

interface Props {
  tema?: 'claro' | 'escuro';
  tamanho?: number;
  sufixoId?: string;
}
const { tema = 'claro', tamanho = 128, sufixoId = 'a' } = Astro.props;
const corAnel = tema === 'claro' ? '#8A6E2B' : '#C9A851';
const corTexto = tema === 'claro' ? '#242424' : '#FAF9F9';
const idCirc = `selo-circ-${sufixoId}`;
const textoAnel = `5,0 ESTRELAS NO GOOGLE  ·  ${avaliacoes.total} AVALIAÇÕES  ·  `;
---

<a
  href={site.social.google}
  target="_blank"
  rel="noopener noreferrer"
  class="inline-block transition-transform duration-300 hover:scale-[1.04]"
  aria-label={`5,0 estrelas no Google, ${avaliacoes.total} avaliações. Abrir perfil em nova aba.`}
>
  <svg
    width={tamanho}
    height={tamanho}
    viewBox="0 0 128 128"
    fill="none"
    role="img"
    aria-hidden="true"
  >
    <defs>
      <path
        id={idCirc}
        d="M64,64 m-49,0 a49,49 0 1,1 98,0 a49,49 0 1,1 -98,0"
      ></path>
    </defs>
    <circle cx="64" cy="64" r="61" stroke={corAnel} stroke-width="1" opacity="0.9"></circle>
    <circle cx="64" cy="64" r="37" stroke={corAnel} stroke-width="0.75" opacity="0.55"></circle>
    <g class="selo-gira" style="transform-origin: 64px 64px;">
      <text
        fill={corAnel}
        font-size="8.4"
        letter-spacing="2.1"
        font-family="InterVariable, system-ui, sans-serif"
        font-weight="500"
      >
        <textPath href={`#${idCirc}`}>{textoAnel}</textPath>
      </text>
    </g>
    <text
      x="64"
      y="66"
      text-anchor="middle"
      dominant-baseline="middle"
      fill={corTexto}
      font-size="27"
      font-family="'Instrument Serif', Georgia, serif"
    >
      {avaliacoes.nota}
    </text>
    <path
      d="M64 78.5 l1.9 3.9 4.3 .6 -3.1 3 .7 4.2 -3.8 -2 -3.8 2 .7 -4.2 -3.1 -3 4.3 -.6 z"
      fill={corAnel}
    ></path>
  </svg>
</a>
