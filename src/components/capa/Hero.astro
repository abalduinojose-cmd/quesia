---
import { site, hero, avaliacoes } from '@/content/data';
import { waLink, waMensagemPadrao } from '@/lib/wa';
import { withBase } from '@/lib/paths';
---

<header id="topo" class="relative flex min-h-[100dvh] overflow-hidden bg-ink text-bone">
  <!-- Mídia de fundo · desktop: foto do ensaio -->
  <picture class="absolute inset-0 hidden md:block" aria-hidden="true">
    <source
      type="image/avif"
      srcset={`${withBase('/hero/hero-1280.avif')} 1280w, ${withBase('/hero/hero-1920.avif')} 1920w, ${withBase('/hero/hero-2560.avif')} 2560w`}
      sizes="100vw"
    />
    <img
      src={withBase('/hero/hero-1920.webp')}
      srcset={`${withBase('/hero/hero-1280.webp')} 1280w, ${withBase('/hero/hero-1920.webp')} 1920w, ${withBase('/hero/hero-2560.webp')} 2560w`}
      sizes="100vw"
      alt=""
      fetchpriority="high"
      decoding="async"
      class="drift h-full w-full object-cover object-[60%_28%]"
    />
  </picture>

  <!-- Mídia de fundo · mobile: vídeo 9:16 (roda SEMPRE; pausa no botão) -->
  <div class="absolute inset-0 md:hidden" aria-hidden="true">
    <video
      id="video-hero"
      class="h-full w-full object-cover"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster={withBase('/hero/poster.jpg')}
    >
      <source src={withBase('/hero/quesia-loop.mp4')} type="video/mp4" />
    </video>
  </div>

  <div class="veu-hero-desktop absolute inset-0 hidden md:block" aria-hidden="true"></div>
  <div class="veu-hero-mobile absolute inset-0 md:hidden" aria-hidden="true"></div>

  <!-- Conteúdo -->
  <div
    class="relative z-10 mx-auto flex w-full max-w-[1280px] flex-col justify-end px-5 pb-16 pt-32 sm:px-8 md:justify-center md:pb-24 lg:px-12"
  >
    <h1
      class="anima max-w-[13ch] font-display text-[clamp(3.1rem,7.2vw,6rem)] leading-[1.04] [text-shadow:0_2px_28px_rgb(0_0_0/0.35)]"
    >
      Defendendo seus <span class="texto-ouro-claro">direitos</span> com
      <span class="texto-ouro-claro">paixão</span>
    </h1>

    <p
      class="anima medida-curta mt-7 text-[1.14rem] leading-relaxed text-bone [text-shadow:0_1px_18px_rgb(0_0_0/0.4)]"
      style="--anima-delay: 120ms"
    >
      <strong class="font-semibold">{hero.subDestaque}</strong>
      {hero.subResto}
    </p>

    <div class="anima mt-9 flex flex-wrap items-center gap-4" style="--anima-delay: 260ms">
      <a
        href={waLink(waMensagemPadrao)}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-ouro rotulo-caps"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 2a8 8 0 1 1-4.2 14.8l-.5-.3-2.5.7.7-2.5-.3-.5A8 8 0 0 1 12 4Zm-3 4.4c-.2 0-.5.1-.7.4-.2.3-.9.9-.9 2.1 0 1.3.9 2.5 1 2.7.1.2 1.8 2.9 4.5 3.9 2.2.9 2.7.7 3.1.7.5 0 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.2-.2-.5-.3l-1.7-.9c-.2-.1-.4-.1-.6.1l-.8.9c-.1.2-.3.2-.5.1a6.5 6.5 0 0 1-3.2-2.8c-.1-.2-.1-.4 0-.5l.6-.8c.2-.2.2-.4.1-.6l-.8-1.9c-.2-.5-.4-.7-.5-.7Z"
            fill="currentColor"
          ></path>
        </svg>
        Conversar no WhatsApp
      </a>
      <a href="#contato" class="btn-contorno-claro rotulo-caps">Fazer pré-agendamento</a>
    </div>

    <a
      href={avaliacoes.url}
      target="_blank"
      rel="noopener noreferrer"
      class="anima link-draw rotulo-caps mt-10 inline-flex w-fit items-center gap-2 text-bone-muted transition-colors hover:text-gold"
      style="--anima-delay: 340ms"
    >
      <span class="text-gold" aria-hidden="true">★</span>
      5,0 no Google · {avaliacoes.total} avaliações
    </a>
  </div>

</header>

<script>
  /* O vídeo de fundo roda SEMPRE em looping (pedido do cliente, sem botão). */
  const v = document.getElementById('video-hero') as HTMLVideoElement | null;

  const tocar = () => {
    if (!v) return;
    v.play().catch(() => {
      const tentar = () => {
        v.play().catch(() => {});
      };
      window.addEventListener('pointerdown', tentar, { once: true });
      window.addEventListener('touchstart', tentar, { once: true });
    });
  };
  tocar();

  document.addEventListener('visibilitychange', () => {
    if (!v) return;
    if (document.hidden) v.pause();
    else tocar();
  });
</script>
