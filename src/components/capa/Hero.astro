---
import { hero, avaliacoes } from '@/content/data';
import { withBase } from '@/lib/paths';
---

<header id="topo" class="relative flex min-h-[100dvh] overflow-hidden bg-ink text-bone">
  <!-- Mídia de fundo · desktop: foto do ensaio -->
  <picture class="absolute inset-0 hidden md:block" aria-hidden="true">
    <source
      type="image/avif"
      srcset={`${withBase('/hero/hero-1280.avif')} 1280w, ${withBase('/hero/hero-1920.avif')} 1920w, ${withBase('/hero/hero-2560.avif')} 2560w`}
      sizes="100vw"
    />
    <img
      src={withBase('/hero/hero-1920.webp')}
      srcset={`${withBase('/hero/hero-1280.webp')} 1280w, ${withBase('/hero/hero-1920.webp')} 1920w, ${withBase('/hero/hero-2560.webp')} 2560w`}
      sizes="100vw"
      alt=""
      fetchpriority="high"
      decoding="async"
      class="drift h-full w-full object-cover object-[60%_18%]"
    />
  </picture>

  <!-- Mídia de fundo · mobile: vídeo 9:16 (roda SEMPRE; pausa no botão) -->
  <div class="absolute inset-0 md:hidden" aria-hidden="true">
    <video
      id="video-hero"
      class="h-full w-full object-cover"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster={withBase('/hero/poster.jpg')}
    >
      <source src={withBase('/hero/quesia-loop.mp4')} type="video/mp4" />
    </video>
  </div>

  <div class="veu-hero-desktop absolute inset-0 hidden md:block" aria-hidden="true"></div>
  <div class="veu-hero-mobile absolute inset-0 md:hidden" aria-hidden="true"></div>

  <!-- Conteúdo -->
  <div
    class="relative z-10 mx-auto flex w-full max-w-[1280px] flex-col justify-end px-5 pb-16 pt-32 sm:px-8 md:justify-center md:pb-24 lg:px-12"
  >
    <!-- As três linhas são fixas: o texto não quebra por acaso, quebra onde
         foi decidido. Cada palavra entra sozinha, com atraso crescente. -->
    <h1
      class="titulo-hero sombra-hero max-w-[15ch] font-display text-[clamp(2.65rem,6.1vw,5rem)] leading-[1.06]"
    >
      <span class="linha-hero">
        <span class="palavra" style="--p: 0">Defendendo</span>
      </span>
      <span class="linha-hero">
        <span class="palavra" style="--p: 1">seus</span>
        <span class="palavra" style="--p: 2"><span class="ouro-hero texto-ouro-claro">direitos</span></span>
      </span>
      <span class="linha-hero">
        <span class="palavra" style="--p: 3">com</span>
        <span class="palavra" style="--p: 4"><span class="ouro-hero texto-ouro-claro">paixão.</span></span>
      </span>
    </h1>

    <p class="sombra-hero-suave medida-curta mt-7 text-[1.14rem] leading-relaxed text-bone">
      <span class="linha-hero entra-hero font-semibold" style="--atraso: 0.52s">
        {hero.subLinha1}
      </span>
      <span class="linha-hero entra-hero" style="--atraso: 0.62s">
        {hero.subLinha2}
      </span>
    </p>

    <div
      class="anima mt-9 flex w-full flex-col items-stretch gap-3.5 sm:w-auto sm:flex-row sm:items-center sm:gap-4"
      style="--anima-delay: 260ms"
    >
      <a href="#agendamento" class="btn-ouro btn-destaque rotulo-caps">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M8 3v3m8-3v3M3.5 9.5h17M5 6h14a1.5 1.5 0 0 1 1.5 1.5V19A1.5 1.5 0 0 1 19 20.5H5A1.5 1.5 0 0 1 3.5 19V7.5A1.5 1.5 0 0 1 5 6Z"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"></path>
        </svg>
        Fazer agendamento
      </a>
      <a href="#areas" class="btn-contorno-claro rotulo-caps justify-center">
        Ver áreas de atuação
      </a>
      <!-- O botão do WhatsApp saiu daqui: o site inteiro passa pelo
           agendamento e só o rodapé abre conversa direta. -->
    </div>

    <a
      href={avaliacoes.url}
      target="_blank"
      rel="noopener noreferrer"
      class="anima link-draw rotulo-caps mt-10 inline-flex w-fit items-center gap-2 text-bone-muted transition-colors hover:text-gold"
      style="--anima-delay: 340ms"
    >
      <span class="text-gold" aria-hidden="true">★</span>
      5,0 no Google · {avaliacoes.total} avaliações
    </a>
  </div>

</header>

<script>
  /* O vídeo de fundo roda SEMPRE em looping (pedido do cliente, sem botão). */
  const v = document.getElementById('video-hero') as HTMLVideoElement | null;

  const tocar = () => {
    if (!v) return;
    v.play().catch(() => {
      const tentar = () => {
        v.play().catch(() => {});
      };
      window.addEventListener('pointerdown', tentar, { once: true });
      window.addEventListener('touchstart', tentar, { once: true });
    });
  };
  tocar();

  document.addEventListener('visibilitychange', () => {
    if (!v) return;
    if (document.hidden) v.pause();
    else tocar();
  });
</script>
