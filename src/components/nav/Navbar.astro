---
import { areasDoMenu, capitulos, site } from '@/content/data';
import { withBase } from '@/lib/paths';

/* A barra do desktop mostra só o essencial. Como funciona, Formação, FAQ e
   Holding continuam na página e no menu do celular, que tem espaço de sobra;
   na barra elas viravam nove itens em fila e nada se destacava. */
const FORA_DA_BARRA = ['como-funciona', 'formacao', 'faq', 'holding'];
const menuDesktop = capitulos.filter((c) => !FORA_DA_BARRA.includes(c.id));

/** Áreas sem seção própria abrem o agendamento já na área certa. */
const hrefArea = (a: { href: string; abreArea?: string }) =>
  a.abreArea ? withBase(`/agendar?area=${encodeURIComponent(a.abreArea)}`) : a.href;
---

<nav id="navbar" class="fixed inset-x-0 top-0 z-50" aria-label="Navegação do site">
  <div
    class="mx-auto flex h-[4.5rem] w-full max-w-[1280px] items-center justify-between gap-5 px-5 sm:px-8 lg:px-12"
  >
    <a href="#topo" class="flex items-center gap-3" aria-label="Voltar ao topo">
      <img
        class="nav-logo-claro h-9 w-auto"
        src={withBase('/logos/qc-mark-bone.png')}
        alt=""
        width="34"
        height="38"
      />
      <img
        class="nav-logo-escuro h-9 w-auto"
        src={withBase('/logos/qc-mark.png')}
        alt=""
        width="34"
        height="38"
      />
      <span class="nav-tinta rotulo-caps hidden sm:block">{site.nome}</span>
    </a>

    <div class="hidden items-center gap-6 lg:flex xl:gap-8">
      {menuDesktop.map((c) =>
        c.id === 'areas' ? (
          <div class="submenu relative" data-submenu>
            <button
              type="button"
              id="gatilho-areas"
              class="submenu-gatilho nav-tinta-suave whitespace-nowrap text-[0.9rem]"
              aria-expanded="false"
              aria-controls="submenu-areas"
            >
              {c.curto}
              <svg
                class="submenu-seta"
                width="10"
                height="10"
                viewBox="0 0 10 10"
                fill="none"
                aria-hidden="true"
              >
                <path d="M1.5 3.5 5 7l3.5-3.5" stroke="currentColor" stroke-width="1.4"
                  stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </button>

            <div id="submenu-areas" class="submenu-caixa" hidden>
              <p class="rotulo-caps px-4 pb-2 pt-1 text-gold-deep">Áreas de atuação</p>
              <ul role="list">
                {areasDoMenu.map((a) => (
                  <li>
                    <a href={hrefArea(a)} class="submenu-item">
                      {a.rotulo}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ) : (
          <a
            href={`#${c.id}`}
            class="nav-tinta-suave link-draw whitespace-nowrap text-[0.9rem]"
          >
            {c.curto}
          </a>
        )
      )}
    </div>

    <div class="flex items-center gap-3">
      <a
        href={withBase('/agendar')}
        class="nav-btn rotulo-caps hidden items-center gap-2 rounded-full px-5 py-2.5 sm:inline-flex"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M8 3v3m8-3v3M3.5 9.5h17M5 6h14a1.5 1.5 0 0 1 1.5 1.5V19A1.5 1.5 0 0 1 19 20.5H5A1.5 1.5 0 0 1 3.5 19V7.5A1.5 1.5 0 0 1 5 6Z"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
          ></path>
        </svg>
        Agendar
      </a>

      <button
        id="abre-menu"
        type="button"
        class="nav-btn flex h-11 w-11 items-center justify-center rounded-full lg:hidden"
        aria-label="Abrir menu"
        aria-expanded="false"
        aria-controls="painel-menu"
      >
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
          <path
            d="M2 4.5h14M2 9h14M2 13.5h14"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
          ></path>
        </svg>
      </button>
    </div>
  </div>
</nav>

<!-- Painel deslizante -->
<div
  id="menu-overlay"
  class="menu-overlay fixed inset-0 z-[60] bg-black/60 backdrop-blur-sm lg:hidden"
  hidden
>
</div>

<aside
  id="painel-menu"
  class="menu-painel fixed inset-y-0 right-0 z-[70] flex w-[86%] max-w-sm flex-col bg-ink text-bone shadow-2xl lg:hidden"
  aria-label="Menu de navegação"
  hidden
>
  <div class="flex items-center justify-between px-7 pb-2 pt-6">
    <img
      src={withBase('/logos/qc-mark-bone.png')}
      alt=""
      width="30"
      height="34"
      class="h-8 w-auto"
    />
    <button
      id="fecha-menu"
      type="button"
      class="flex h-10 w-10 items-center justify-center rounded-full text-bone-muted transition-colors hover:text-gold"
      aria-label="Fechar menu"
    >
      <svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true">
        <path
          d="M3 3l10 10M13 3L3 13"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
        ></path>
      </svg>
    </button>
  </div>

  <nav class="flex-1 overflow-y-auto px-7 py-6" aria-label="Seções do site">
    <ul class="flex flex-col" role="list">
      {capitulos.map((c, i) =>
        c.id === 'areas' ? (
          /* <details> em vez de JS: abre, fecha e é acessível de graça */
          <li>
            <details class="menu-item group" style={`--i: ${i}`}>
              <summary class="flex cursor-pointer items-baseline gap-3 py-3 font-display text-[1.32rem] leading-snug text-bone-muted transition-colors duration-300 hover:text-bone">
                <span
                  class="h-px w-0 shrink-0 bg-gold transition-all duration-300 group-hover:w-5"
                  aria-hidden="true"
                >
                </span>
                {c.titulo}
                <svg
                  class="submenu-seta ml-1 self-center"
                  width="11"
                  height="11"
                  viewBox="0 0 10 10"
                  fill="none"
                  aria-hidden="true"
                >
                  <path d="M1.5 3.5 5 7l3.5-3.5" stroke="currentColor" stroke-width="1.4"
                    stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </summary>
              <ul class="mb-2 ml-8 flex flex-col border-l border-bone/15 pl-4" role="list">
                {areasDoMenu.map((a) => (
                  <li>
                    <a
                      href={hrefArea(a)}
                      class="block py-2 text-[0.98rem] text-bone-muted transition-colors duration-200 hover:text-gold"
                    >
                      {a.rotulo}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          </li>
        ) : (
          <li>
            <a
              href={`#${c.id}`}
              class="menu-item group flex items-baseline gap-3 py-3 font-display text-[1.32rem] leading-snug text-bone-muted transition-colors duration-300 hover:text-bone"
              style={`--i: ${i}`}
            >
              <span
                class="h-px w-0 shrink-0 bg-gold transition-all duration-300 group-hover:w-5"
                aria-hidden="true"
              >
              </span>
              {c.titulo}
            </a>
          </li>
        )
      )}
    </ul>
  </nav>

  <div class="flex flex-col gap-3 px-7 pb-9 pt-4">
    <a
      href={withBase('/agendar')}
      class="btn-clean w-full justify-center text-[0.95rem]"
    >
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M8 3v3m8-3v3M3.5 9.5h17M5 6h14a1.5 1.5 0 0 1 1.5 1.5V19A1.5 1.5 0 0 1 19 20.5H5A1.5 1.5 0 0 1 3.5 19V7.5A1.5 1.5 0 0 1 5 6Z"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
        ></path>
      </svg>
      Agendar atendimento
    </a>
    <a
      href="#agendamento"
      class="flex w-full items-center justify-center gap-2.5 rounded-full border border-bone/20 px-5 py-3.5 text-[0.92rem] text-bone-muted transition-colors duration-300 hover:border-gold hover:text-gold"
    >
      Ver horários livres
    </a>
  </div>
</aside>

<script>
  const nav = document.getElementById('navbar');
  const aoRolar = () => nav?.classList.toggle('nav-solida', window.scrollY > 40);
  aoRolar();
  document.addEventListener('scroll', aoRolar, { passive: true });

  const abre = document.getElementById('abre-menu');
  const fecha = document.getElementById('fecha-menu');
  const painel = document.getElementById('painel-menu');
  const overlay = document.getElementById('menu-overlay');

  const abrirMenu = () => {
    if (!painel || !overlay) return;
    painel.hidden = false;
    overlay.hidden = false;
    /* deixa o navegador pintar o estado inicial antes de animar */
    requestAnimationFrame(() => {
      painel.classList.add('aberto');
      overlay.classList.add('aberto');
    });
    abre?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    painel.querySelector<HTMLAnchorElement>('a')?.focus({ preventScroll: true });
  };

  const fecharMenu = () => {
    if (!painel || !overlay) return;
    painel.classList.remove('aberto');
    overlay.classList.remove('aberto');
    abre?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    window.setTimeout(() => {
      painel.hidden = true;
      overlay.hidden = true;
    }, 320);
  };

  /* Submenu de áreas no desktop: abre no hover, alterna no clique, fecha no Esc
     e ao clicar fora. O clique existe para quem navega por teclado ou toque. */
  const caixaAreas = document.getElementById('submenu-areas');
  const gatilhoAreas = document.getElementById('gatilho-areas');
  const grupoAreas = gatilhoAreas?.closest('[data-submenu]');

  const mostrarAreas = (abrir: boolean) => {
    if (!caixaAreas || !gatilhoAreas) return;
    caixaAreas.hidden = !abrir;
    grupoAreas?.classList.toggle('aberto', abrir);
    gatilhoAreas.setAttribute('aria-expanded', String(abrir));
  };

  if (caixaAreas && gatilhoAreas && grupoAreas) {
    grupoAreas.addEventListener('mouseenter', () => mostrarAreas(true));
    grupoAreas.addEventListener('mouseleave', () => mostrarAreas(false));
    gatilhoAreas.addEventListener('click', () =>
      mostrarAreas(caixaAreas.hidden)
    );
    caixaAreas.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => mostrarAreas(false))
    );
    document.addEventListener('click', (e) => {
      if (!grupoAreas.contains(e.target as Node)) mostrarAreas(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') mostrarAreas(false);
    });
    /* Rolar a página com o menu aberto e o mouse parado deixaria a caixa
       flutuando sobre o conteúdo. */
    document.addEventListener('scroll', () => mostrarAreas(false), { passive: true });
  }

  abre?.addEventListener('click', abrirMenu);
  fecha?.addEventListener('click', fecharMenu);
  overlay?.addEventListener('click', fecharMenu);
  painel?.querySelectorAll('a').forEach((a) => a.addEventListener('click', fecharMenu));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && painel && !painel.hidden) fecharMenu();
  });
</script>
